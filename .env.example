# proactive-agent-starter configuration. Copy to .env (optional). Every default works offline with zero keys.

# API server
PAS_PORT=4851
PAS_HOST=127.0.0.1
PAS_DATA_DIR=./data

# Bearer tokens (each >= 32 chars, and they must differ). Leave unset to use the offline dev defaults.
# PAS_CLIENT_TOKEN=
# PAS_CRON_TOKEN=

# Model provider: "faux" (offline, default) or "openrouter"
PAS_PROVIDER=faux
# PAS_MODEL=
# OPENROUTER_API_KEY=

# Cron
PAS_API_URL=http://127.0.0.1:4851
PAS_CRON_INTERVAL_MS=60000
